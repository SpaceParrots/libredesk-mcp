{
  "name": "@spaceparrots/libredesk-mcp",
  "version": "0.0.0",
  "description": "CLI tool and MCP server for the LibreDesk helpdesk API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ldesk": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "dev:up": "docker compose -f docker-compose.dev.yml -p ldesk-dev up -d",
    "dev:down": "docker compose -f docker-compose.dev.yml -p ldesk-dev down",
    "dev:bootstrap": "node dev/bootstrap.mjs",
    "start": "node dist/index.js",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --config vitest.live.config.ts",
    "docs:undocumented": "node scripts/list-undocumented.mjs",
    "prepack": "npm run build",
    "verify": "npm run lint && npm run typecheck && npm test"
  },
  "keywords": [
    "libredesk",
    "helpdesk",
    "mcp",
    "cli",
    "knowledge-base",
    "claude"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpaceParrots/libredesk-mcp.git"
  },
  "homepage": "https://github.com/SpaceParrots/libredesk-mcp#readme",
  "bugs": {
    "url": "https://github.com/SpaceParrots/libredesk-mcp/issues"
  },
  "author": "SpaceParrots",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "marked": "^18.1.1",
    "node-html-parser": "^9.0.5",
    "turndown": "^7.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
